{
  "schema_version": "agent2host/v1alpha1",
  "kind": "Agent",
  "id": "batch-runner",
  "name": "Batch runner",
  "description": "Loop checklist executor.",
  "sop": "./sops/batch-runner.sop.md",
  "skills": [
    "batch-checklist"
  ],
  "contexts": [
    {
      "path": "./contexts/deploy-checklist.md",
      "loading": "on_demand"
    }
  ],
  "mcp_servers": {
    "deploy-tools": {
      "transport": "stdio",
      "command": "python3",
      "args": [
        "-u",
        "./mcp/deploy-tools.py"
      ],
      "files": [
        "./mcp/deploy-tools.py"
      ],
      "tools": [
        "rollback_status",
        "health_check"
      ]
    }
  },
  "permissions": {
    "filesystem": {
      "read": [
        "working_directory"
      ],
      "write": []
    },
    "network": {
      "default": "deny"
    }
  },
  "approvals": {
    "shell_execute": "on_boundary"
  }
}
