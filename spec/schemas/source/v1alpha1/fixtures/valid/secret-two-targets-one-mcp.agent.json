{
  "schema_version": "agent2host/v1alpha1",
  "kind": "Agent",
  "id": "demo",
  "sop": "./sops/demo.sop.md",
  "mcp_servers": {
    "club-database": {
      "transport": "stdio",
      "command": "python",
      "files": [
        "./mcp/club-database.py"
      ],
      "tools": [
        "search_policy"
      ],
      "environment": [
        {
          "value_from": {
            "environment": "CLUB_DB_TOKEN"
          },
          "required": true
        },
        {
          "value_from": {
            "environment": "CLUB_DB_READONLY"
          },
          "required": false
        }
      ]
    }
  }
}
