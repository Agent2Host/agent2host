{
  "schema_version": "agent2host/v1alpha1",
  "kind": "Agent",
  "id": "demo",
  "sop": "./sops/demo.sop.md",
  "hooks": {
    "before_tool_call": [
      {
        "command": "python",
        "args": [
          "./hooks/audit.py"
        ],
        "files": [
          "./hooks/audit.py"
        ],
        "environment": [
          {
            "value_from": {
              "environment": "AUDIT_TOKEN"
            },
            "required": true
          }
        ]
      }
    ]
  }
}
