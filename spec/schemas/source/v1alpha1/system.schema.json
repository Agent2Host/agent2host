{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent2host:schema:source:v1alpha1:system",
  "title": "Agent2Host AgentSystem (v1alpha1)",
  "description": "Published agent2host/v1alpha1 AgentSystem. $ref targets are URNs; validators must map URNs to files (see spec/schemas/README.md).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "version", "agents"],
  "properties": {
    "schema_version": { "$ref": "urn:agent2host:schema:source:v1alpha1:common#/$defs/schema_version" },
    "kind": { "type": "string", "const": "AgentSystem" },
    "id": { "$ref": "urn:agent2host:schema:source:v1alpha1:common#/$defs/local_id" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "$ref": "urn:agent2host:schema:source:v1alpha1:common#/$defs/semver" },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:agent2host:schema:source:v1alpha1:common#/$defs/portable_path" }
    },
    "skills": {
      "type": "object",
      "propertyNames": { "$ref": "urn:agent2host:schema:source:v1alpha1:common#/$defs/local_id" },
      "additionalProperties": { "$ref": "urn:agent2host:schema:source:v1alpha1:common#/$defs/skill_entry" }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "context_access": {
          "type": "string",
          "enum": ["explicit"],
          "description": "SRC-DEFAULT-SYSTEM. Omitted member → explicit."
        },
        "cross_system_access": {
          "type": "string",
          "enum": ["deny"],
          "description": "SRC-DEFAULT-SYSTEM. Omitted member → deny."
        }
      }
    },
    "extensions": { "$ref": "urn:agent2host:schema:source:v1alpha1:common#/$defs/extensions" }
  }
}
