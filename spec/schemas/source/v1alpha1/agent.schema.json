{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent2host:schema:source:v1alpha1:agent",
  "title": "Agent2Host Agent Spec (v1alpha1)",
  "description": "Published agent2host/v1alpha1 Agent Spec. Nested permissions/approvals/sandbox are closed objects (SRC-SEC-*). $ref targets are URNs; validators must map URNs to files (see spec/schemas/README.md).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "sop"],
  "properties": {
    "schema_version": { "$ref": "urn:agent2host:schema:source:v1alpha1:common#/$defs/schema_version" },
    "kind": { "type": "string", "const": "Agent" },
    "id": { "$ref": "urn:agent2host:schema:source:v1alpha1:common#/$defs/local_id" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "sop": { "$ref": "urn:agent2host:schema:source:v1alpha1:common#/$defs/portable_path" },
    "skills": {
      "type": "array",
      "items": { "$ref": "urn:agent2host:schema:source:v1alpha1:common#/$defs/skill_ref" }
    },
    "contexts": {
      "type": "array",
      "items": { "$ref": "urn:agent2host:schema:source:v1alpha1:common#/$defs/context_entry" }
    },
    "mcp_servers": {
      "type": "object",
      "propertyNames": { "$ref": "urn:agent2host:schema:source:v1alpha1:common#/$defs/local_id" },
      "additionalProperties": { "$ref": "urn:agent2host:schema:source:v1alpha1:common#/$defs/mcp_server" }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_start": {
          "type": "array",
          "items": { "$ref": "urn:agent2host:schema:source:v1alpha1:common#/$defs/hook_entry" }
        },
        "before_tool_call": {
          "type": "array",
          "items": { "$ref": "urn:agent2host:schema:source:v1alpha1:common#/$defs/hook_entry" }
        },
        "after_tool_call": {
          "type": "array",
          "items": { "$ref": "urn:agent2host:schema:source:v1alpha1:common#/$defs/hook_entry" }
        },
        "agent_stop": {
          "type": "array",
          "items": { "$ref": "urn:agent2host:schema:source:v1alpha1:common#/$defs/hook_entry" }
        }
      }
    },
    "environment": {
      "type": "array",
      "items": { "$ref": "urn:agent2host:schema:source:v1alpha1:common#/$defs/environment_binding" }
    },
    "permissions": { "$ref": "urn:agent2host:schema:source:v1alpha1:common#/$defs/permissions" },
    "approvals": { "$ref": "urn:agent2host:schema:source:v1alpha1:common#/$defs/approvals" },
    "sandbox": { "$ref": "urn:agent2host:schema:source:v1alpha1:common#/$defs/sandbox" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema"],
      "properties": {
        "schema": { "$ref": "urn:agent2host:schema:source:v1alpha1:common#/$defs/portable_path" },
        "enforcement": {
          "type": "string",
          "enum": ["required", "best_effort"],
          "description": "SRC-DEFAULT-OUTPUT. Omitted → best_effort. Presence of schema alone never forces validation."
        }
      }
    },
    "extensions": { "$ref": "urn:agent2host:schema:source:v1alpha1:common#/$defs/extensions" }
  }
}
